{
  "name": "deepclause-sop2harness",
  "version": "0.0.1",
  "description": "sop2harness (s2h): turn SOPs into versioned, exportable DeepClause DML harnesses.",
  "type": "module",
  "license": "MIT",
  "author": "DeepClause",
  "repository": {
    "type": "git",
    "url": "https://github.com/deepclause/sop2harness.git"
  },
  "bugs": {
    "url": "https://github.com/deepclause/sop2harness/issues"
  },
  "homepage": "https://github.com/deepclause/sop2harness#readme",
  "keywords": [
    "deepclause",
    "sop",
    "sop2harness",
    "dml",
    "harness",
    "agent",
    "llm",
    "cli",
    "prolog",
    "neurosymbolic"
  ],
  "bin": {
    "s2h": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "skills",
    "docs/*.md",
    "docs/DECISIONS",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "commander": "^12.1.0",
    "deepclause-sdk": "0.0.89",
    "deepclause-pi": "0.5.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
